from collections import defaultdict

class GraphAStar:
    """Graph class for A* Search implementation."""

    def __init__(self):
        self.adj_list = {}

    def add_edge(self, node1, node2, cost=1):
        """Add an undirected edge with given cost."""
        if node1 not in self.adj_list:
            self.adj_list[node1] = []
        if node2 not in self.adj_list:
            self.adj_list[node2] = []
        self.adj_list[node1].append((node2, cost))
        self.adj_list[node2].append((node1, cost))

    def a_star(self, start, goal, heuristic):
        """
        Perform A* Search to find the lowest-cost path to the goal.
        f(n) = g(n) + h(n)
        """
        open_list = []  # priority queue
        heappush(open_list, (heuristic[start], 0, start))  # (f, g, node)

        g_costs = defaultdict(lambda: float("inf"))
        g_costs[start] = 0

        closed_set = set()

        print("\n🔹 Starting A* Search...\n")

        while open_list:
            f, g, current_node = heappop(open_list)
            print(f"Exploring: {current_node} | f={f}, g={g}")

            if current_node == goal:
                print(f"\n✅ Goal '{goal}' found with total cost {g} using A* Search!")
                return True

            if current_node in closed_set:
                continue
            closed_set.add(current_node)

            for neighbor, cost in self.adj_list[current_node]:
                g_new = g + cost
                if g_new < g_costs[neighbor]:
                    g_costs[neighbor] = g_new
                    f_new = g_new + heuristic[neighbor]
                    heappush(open_list, (f_new, g_new, neighbor))

        print(f"❌ Goal '{goal}' not found.")
        return False


# ---------- Example Usage ----------
astar_graph = GraphAStar()
astar_graph.add_edge("A", "B", 1)
astar_graph.add_edge("A", "C", 3)
astar_graph.add_edge("B", "D", 1)
astar_graph.add_edge("B", "E", 3)
astar_graph.add_edge("C", "F", 1)
astar_graph.add_edge("E", "G", 1)

heuristic_costs = {
    "A": 5,
    "B": 4,
    "C": 3,
    "D": 10,
    "E": 1,
    "F": 2,
    "G": 0
}

astar_graph.a_star("A", "G", heuristic_costs)


