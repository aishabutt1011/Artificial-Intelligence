# TASK 1: Greedy Best-First Search (GBFS)
# ------------------------------------------------------------

from heapq import heappush, heappop

class GraphGreedy:
    """Graph class for Greedy Best-First Search implementation."""

    def __init__(self):
        self.adj_list = {}

    def add_edge(self, node1, node2):
        """Add an undirected edge between node1 and node2."""
        if node1 not in self.adj_list:
            self.adj_list[node1] = []
        if node2 not in self.adj_list:
            self.adj_list[node2] = []
        if node2 not in self.adj_list[node1]:
            self.adj_list[node1].append(node2)
        if node1 not in self.adj_list[node2]:
            self.adj_list[node2].append(node1)

    def greedy_best_first(self, start, goal, heuristic):
        """Perform Greedy Best-First Search using given heuristic values."""
        visited = set()
        priority_queue = []

        heappush(priority_queue, (heuristic[start], start))
        visited.add(start)

        print("🔹 Starting Greedy Best-First Search...\n")

        while priority_queue:
            _, current_node = heappop(priority_queue)
            print(f"Visiting: {current_node}")

            if current_node == goal:
                print(f"\n✅ Goal node '{goal}' found using Greedy Search!")
                return True

            for neighbor in self.adj_list[current_node]:
                if neighbor not in visited:
                    heappush(priority_queue, (heuristic[neighbor], neighbor))
                    visited.add(neighbor)

        print(f"❌ Goal node '{goal}' not found.")
        return False


# ---------- Example Usage ----------
greedy_graph = GraphGreedy()
greedy_graph.add_edge("A", "B")
greedy_graph.add_edge("A", "C")
greedy_graph.add_edge("B", "D")
greedy_graph.add_edge("B", "E")
greedy_graph.add_edge("C", "F")
greedy_graph.add_edge("E", "G")

# Smaller heuristic value = closer to goal
heuristic_values = {
    "A": 5,
    "B": 4,
    "C": 3,
    "D": 10,
    "E": 1,
    "F": 2,
    "G": 0
}

greedy_graph.greedy_best_first("A", "G", heuristic_values)


