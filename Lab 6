# ------------------------------------------------------------
# TASK 2: DFS (Depth-First Search) Implementation
# ------------------------------------------------------------
# Graph structure:
#                       A
#                   / / |  \   
#                 B   F D    E
#                / \    |   / | \
#               K   J   G  C  H  I
#              / \               |
#             N   M              L
# ------------------------------------------------------------

class Graph:
    """Graph implementation supporting DFS traversal."""

    def __init__(self):
        # Initialize adjacency list
        self.adj_list = {}

    def add_edge(self, u, v):
        """
        Add an edge from 'u' to 'v' and maintain reverse-sorted order
        so that DFS processes nodes in a consistent LIFO manner.
        """
        if u not in self.adj_list:
            self.adj_list[u] = []
        self.adj_list[u].append(v)
        self.adj_list[u].sort(reverse=True)  # Ensures deterministic DFS order

    def print_graph(self):
        """Display adjacency list of the graph."""
        for node in self.adj_list:
            print(f"{node} --> {self.adj_list[node]}")

    def dfs_iterative(self, start, goal):
        """
        Perform iterative Depth-First Search (DFS) from start node to goal node.
        Returns the path to goal if found, otherwise None.
        """
        stack = [start]  # LIFO stack
        visited = set()
        path = []

        print("\n🚀 Starting DFS Traversal...\n")

        while stack:
            current_node = stack.pop()  # Pop last inserted node

            if current_node not in visited:
                print(f"Visiting node: {current_node}")
                path.append(current_node)
                visited.add(current_node)

                # Goal check
                if current_node == goal:
                    print(f"\n🎯 Goal node '{goal}' found!")
                    return path

                # Add unvisited neighbors to stack
                neighbors = self.adj_list.get(current_node, [])
                for neighbor in neighbors:
                    if neighbor not in visited:
                        stack.append(neighbor)

        print(f"\n⚠️ Goal node '{goal}' not found.")
        return None


# -------------------- Creating the second graph --------------------
graph2 = Graph()

# Adding edges based on given tree structure
