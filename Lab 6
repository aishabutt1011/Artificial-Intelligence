# TASK 1: Graph Implementation using Adjacency List
# ------------------------------------------------------------
# Structure:
#                     1
#                   / | \
#                 2   7  8
#                / \    / \
#               3   6  9  12
#              / \    / \
#             4   5  10 11
# ------------------------------------------------------------

class Graph:
    """A simple directed graph implementation using adjacency list."""

    def __init__(self):
        # Initialize an empty dictionary to store adjacency lists
        self.adj_list = {}

    def add_edge(self, u, v):
        """
        Add an edge from node 'u' to node 'v'.
        If 'u' is not present in the adjacency list, initialize it.
        """
        if u not in self.adj_list:
            self.adj_list[u] = []
        self.adj_list[u].append(v)

    def print_graph(self):
        """Print the adjacency list of the graph."""
        for node in self.adj_list:
            print(f"{node} --> {self.adj_list[node]}")


# Creating graph based on the given tree structure
