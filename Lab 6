# Display adjacency list
print("📘 Adjacency List for Alphabetical Graph:")
graph2.print_graph()

# Run DFS to find goal 'G'
print("\n--- DFS Traversal ---")
path_to_goal = graph2.dfs_iterative(start='A', goal='G')

if path_to_goal:
    print(f"\n✅ Path to goal 'G': {' -> '.join(path_to_goal)}")
else:
    print("\n❌ Goal not found in traversal.")
