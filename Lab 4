# TASK 1: Implementing Stack
# ------------------------------------------------------------

class MyStack:
    def __init__(self):
        # Initialize an empty list to represent the stack
        self.stack_list = []

    def push_item(self, value):
        """Insert (push) an element into the stack."""
        self.stack_list.append(value)
        print(f"✅ Inserted {value} into stack")

    def pop_item(self):
        """Remove (pop) the top element from the stack."""
        if not self.is_empty():
            removed = self.stack_list.pop()
            print(f"❌ Removed {removed} from stack")
            return removed
        return "⚠️ Stack is empty"

    def is_empty(self):
        """Check if the stack is empty."""
        return len(self.stack_list) == 0

    def show_stack(self):
        """Display the current contents of the stack."""
        print("📦 Current Stack:", self.stack_list)

    def top_element(self):
        """Return the top element without removing it."""
        if not self.is_empty():
            return self.stack_list[-1]
        return "⚠️ Stack is empty"


# -------------------- STACK DEMONSTRATION --------------------

stack_obj = MyStack()
stack_obj.push_item(10)
stack_obj.push_item(20)
stack_obj.show_stack()
print("\n")

# Insert more elements dynamically
while True:
    user_choice = int(input("Do you want to insert more elements? (1 = Yes, 0 = No): "))
    if user_choice == 1:
        new_element = int(input("Enter element: "))
        stack_obj.push_item(new_element)
    elif user_choice == 0:
        stack_obj.show_stack()
        print("🙏 Thanks! All elements inserted.")
        break
    else:
        print("❗ Invalid choice. Try again...")
print("\n")

# View the top element
while True:
    if not stack_obj.is_empty():
        see_top = int(input("Do you want to check top element? (1 = Yes, 0 = No): "))
        if see_top == 1:
            print("🔝 Top element is:", stack_obj.top_element())
        elif see_top == 0:
            print("👍 Okay!")
            break
        else:
            print("❗ Invalid Choice. Try again...")
    else:
        print("⚠️ Stack is empty!")
        break
print("\n")

# Remove elements from the stack
while True:
    if not stack_obj.is_empty():
        remove_top = int(input("Do you want to remove top element? (1 = Yes, 0 = No): "))
        if remove_top == 1:
            stack_obj.pop_item()
        elif remove_top == 0:
            print("👍 Okay!")
            stack_obj.show_stack()
            break
        else:
            print("❗ Invalid Choice. Try again...")
    else:
        print("⚠️ Stack is empty!")
        break
print("\n")


