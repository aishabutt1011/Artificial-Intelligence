# TASK 3: Binary Search Implementation
# ------------------------------------------------------------

def binary_search(num_list, target_value):
    """
    Perform binary search on a sorted list.
    Returns the index if found, otherwise a message.
    """
    start_index = 0
    end_index = len(num_list) - 1

    while start_index <= end_index:
        mid_index = (start_index + end_index) // 2

        if num_list[mid_index] == target_value:
            return f"✅ Value found at index {mid_index}"
        elif num_list[mid_index] < target_value:
            start_index = mid_index + 1
        else:
            end_index = mid_index - 1

    return "❌ Value not present in the list"


# -------------------- BINARY SEARCH DEMONSTRATION --------------------

numbers = list(map(int, input("Enter a sorted list of numbers (space separated): ").split()))
search_value = int(input("Enter the value to search: "))
print(binary_search(numbers, search_value))
