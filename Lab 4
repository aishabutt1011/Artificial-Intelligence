# TASK 1: Implementing Stack
# ------------------------------

class MyStack:
    def __init__(self):
        # Initialize an empty list to store stack elements
        self.items = []

    def push_item(self, val):
        """Push (insert) an item onto the stack."""
        self.items.append(val)
        print(f"✅ Inserted {val} into stack")

    def pop_item(self):
        """Pop (remove) the top item from the stack."""
        if not self.is_empty():
            removed = self.items.pop()
            print(f"❌ Removed {removed} from stack")
            return removed
        return "⚠️ Stack is empty"

    def is_empty(self):
        """Check if the stack is empty."""
        return len(self.items) == 0

    def show(self):
        """Display all elements currently in the stack."""
        print("📦 Current Stack:", self.items)

    def top(self):
        """Return the top element of the stack without removing it."""
        if not self.is_empty():
            return self.items[-1]
        return "⚠️ Stack is empty"


# ------------------------------
# Stack Interaction
# ------------------------------

st = MyStack()
st.push_item(10)
st.push_item(20)
st.show()
print("\n")

# Asking user to insert more elements
while True:
    opt = int(input("Do you want to insert more elements? (1 = Yes, 0 = No): "))
    if opt == 1:
        elem = int(input("Enter element: "))
        st.push_item(elem)
    elif opt == 0:
        st.show()
        print("🙏 Thanks for inserting elements!")
        break
    else:
        print("❗ Invalid choice. Try again...")
print("\n")

# Checking the top element
while True:
    if not st.is_empty():
        see = int(input("Do you want to check top element? (1 = Yes, 0 = No): ")) 
        if see == 1:
            print("🔝 Top element is:", st.top())
        elif see == 0:
            print("👍 Okay!")
            break
        else:
            print("❗ Invalid Choice. Try again...")
    else:
        print("⚠️ Stack is empty!")
        break
print("\n")

# Removing elements from the stack
while True:
    if not st.is_empty():
        rem = int(input("Do you want to remove top element? (1 = Yes, 0 = No): ")) 
        if rem == 1:
            st.pop_item()
        elif rem == 0:
            print("👍 Okay!")
            st.show()
            break
        else:
            print("❗ Invalid Choice. Try again...")
    else:
        print("⚠️ Stack is empty!")
        break
print("\n")


# ------------------------------
# TASK 2: Implementing Queue
# ------------------------------

class MyQueue:
    def __init__(self):
        # Initialize an empty list to store queue elements
        self.items = []

    def add(self, val):
        """Add (enqueue) an item at the end of the queue."""
        self.items.append(val)
        print(f"✅ Inserted {val} into Queue")

    def remove(self):
        """Remove (dequeue) the front item from the queue."""
        if not self.is_empty():
            removed = self.items.pop(0)
            print(f"❌ Removed {removed} from Queue")
            return removed
        return "⚠️ Queue is empty"

    def is_empty(self):
        """Check if the queue is empty."""
        return len(self.items) == 0

    def peek_front(self):
        """Return the front element without removing it."""
        if not self.is_empty():
            return self.items[0]
        return "⚠️ Queue is empty"

    def show(self):
        """Display all elements currently in the queue."""
        print("🚶 Current Queue:", self.items)


# ------------------------------
# Queue Demonstration
# ------------------------------

qu = MyQueue()
qu.add(10)
qu.add(20)
qu.add(30)
qu.show()
print("\n")

qu.remove()
qu.show()
print("\n")

print("🎯 Front element is:", qu.peek_front())
print("\n")


