# TASK 2: Implementing Queue
# ------------------------------------------------------------

class MyQueue:
    def __init__(self):
        # Initialize an empty list to represent the queue
        self.queue_list = []

    def enqueue(self, value):
        """Add (enqueue) an element to the end of the queue."""
        self.queue_list.append(value)
        print(f"✅ Inserted {value} into Queue")

    def dequeue(self):
        """Remove (dequeue) an element from the front of the queue."""
        if not self.is_empty():
            removed = self.queue_list.pop(0)
            print(f"❌ Removed {removed} from Queue")
            return removed
        return "⚠️ Queue is empty"

    def is_empty(self):
        """Check if the queue is empty."""
        return len(self.queue_list) == 0

    def peek_front(self):
        """Return the front element of the queue without removing it."""
        if not self.is_empty():
            return self.queue_list[0]
        return "⚠️ Queue is empty"

    def show_queue(self):
        """Display all elements currently in the queue."""
        print("🚶 Current Queue:", self.queue_list)


# -------------------- QUEUE DEMONSTRATION --------------------

queue_obj = MyQueue()
queue_obj.enqueue(10)
queue_obj.enqueue(20)
queue_obj.enqueue(30)
queue_obj.show_queue()
print("\n")

queue_obj.dequeue()
queue_obj.show_queue()
print("\n")

print("🎯 Front element is:", queue_obj.peek_front())
print("\n")


